    },
    "How far the brightness is smoothed before it displaces the lines, from sharp ridges to rounded hills": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How far the brightness is smoothed before it displaces the lines, from sharp ridges to rounded hills"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在位移线条之前平滑亮度的程度，从尖锐的脊到圆滑的丘"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在位移線條之前平滑亮度的程度，從尖銳的脊到圓滑的丘"
          }
        }
      }
    },
    "How much of each pixel's error spreads to its neighbors. Less gives flatter areas": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much of each pixel's error spreads to its neighbors. Less gives flatter areas"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个像素的误差向相邻像素扩散的程度。较小的值使区域更平坦"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個像素的誤差向相鄰像素擴散的程度。較小的值使區域更平坦"
          }
        }
      }
    },
    "How much of the gap a bright line fills; dimmer parts draw it thinner": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much of the gap a bright line fills; dimmer parts draw it thinner"
