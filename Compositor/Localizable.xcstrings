      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the source moving with the brush between strokes; off starts every stroke at the source point"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在笔画之间让源点随画笔移动；关闭则每笔都从源点开始"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在筆畫之間讓源點隨筆刷移動；關閉則每筆都從源點開始"
          }
        }
      }
    },
    "Keeps this point fixed. Artwork is not scaled; cropped content remains outside the canvas.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps this point fixed. Artwork is not scaled; cropped content remains outside the canvas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持此点固定。图稿不缩放；裁掉的内容仍留在画布之外。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持此點固定。圖稿不縮放；裁掉的內容仍留在畫布之外。"
          }
        }
      }
    },
