        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "亮线填充间隙的程度；较暗部分画得更细"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "亮線填滿間隙的程度；較暗部分畫得更細"
          }
        }
      }
    },
