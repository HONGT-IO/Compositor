    "Drag a color in the picture. Nearby color families move together.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag a color in the picture. Nearby color families move together."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在图像中拖动一种颜色。邻近的色系会一起移动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在影像中拖移一種顏色。鄰近的色系會一起移動。"
          }
        }
      }
    },
    "Drag a rectangle · Shift add · Option subtract · Shift again mid-drag square · Drag inside to move · ⌘-drag moves pixels · Delete clears · ⌘D deselect": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag a rectangle · Shift add · Option subtract · Shift again mid-drag square · Drag inside to move · ⌘-drag moves pixels · Delete clears · ⌘D deselect"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖出矩形 · Shift 添加 · Option 减去 · 拖动中再按 Shift 得到正方形 · 在内部拖动以移动 · ⌘-拖移移动像素 · Delete 清除 · ⌘D 取消选择"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖出矩形 · Shift 加入 · Option 減去 · 拖移中再按 Shift 得到正方形 · 在內部拖移以移動 · ⌘-拖移移動像素 · Delete 清除 · ⌘D 取消選取"
          }
        }
      }
    },
