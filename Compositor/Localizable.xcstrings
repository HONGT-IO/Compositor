    "Highlight Priority protects bright edges. Color Priority also reduces color. Paint Overlay covers the edges evenly.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Highlight Priority protects bright edges. Color Priority also reduces color. Paint Overlay covers the edges evenly."
