    "The brush trails the pointer on a string this long, so a shaky hand still draws a smooth line": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The brush trails the pointer on a string this long, so a shaky hand still draws a smooth line"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画笔以这么长的线跟在指针后面，手抖时仍能画出平滑的线"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "筆刷以這麼長的線跟在指標後面，手抖時仍能畫出平滑的線"
          }
        }
      }
    },
    "The canvas could not be rendered. Try a smaller canvas.": {
