    "That selection is too detailed to outline. Try a different Tolerance, or turn on Contiguous.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That selection is too detailed to outline. Try a different Tolerance, or turn on Contiguous."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该选区过于细碎，无法描边。请尝试不同的容差，或打开连续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該選取範圍過於細碎，無法描邊。請嘗試不同的容差，或打開連續。"
          }
        }
      }
    },
    "That shape is too large. A shape can cover up to %lld megapixels.": {
      "localizations": {
        "en": {
