    "“%@” is a folder, which has no pixels of its own. Paint on a layer inside it, or on the folder’s mask.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is a folder, which has no pixels of its own. Paint on a layer inside it, or on the folder’s mask."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”是文件夹，本身没有像素。请在其中的图层上绘制，或在文件夹的蒙版上绘制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」是檔案夾，本身沒有像素。請在其中的圖層上繪製，或在檔案夾的遮色片上繪製。"
          }
        }
      }
    },
    "“%@” is an adjustment layer, with no pixels to paint. Paint on its mask instead.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is an adjustment layer, with no pixels to paint. Paint on its mask instead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”是调整图层，没有可绘制的像素。请改在其蒙版上绘制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」是調整圖層，沒有可繪製的像素。請改在其遮色片上繪製。"
          }
        }
      }
    },
    "“%@” is hidden, or inside a hidden folder. Show it to paint on it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is hidden, or inside a hidden folder. Show it to paint on it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已隐藏，或位于隐藏的文件夹中。请显示后再绘制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」已隱藏，或位於隱藏的檔案夾中。請顯示後再繪製。"
          }
        }
      }
    },
    "“%@” was changed on disk.": {
      "localizations": {
        "en": {
